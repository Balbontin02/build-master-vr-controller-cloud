{
  "name": "build-master-vr-controller",
  "version": "0.1.0",
  "private": true,
  "description": "Build Master VR Controller - Control remoto de tours inmobiliarios KRPano/D5 desde Meta Quest en red local",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run build:bookmarklet && npm run build:controller && concurrently -k -n SERVER,CONTROLLER \"npm:dev:server\" \"npm:dev:controller\"",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:controller": "npm run dev --workspace apps/controller",
    "build": "npm run build:shared && npm run build:bookmarklet && npm run build:controller && npm run build:server",
    "build:prod": "npm run build",
    "build:shared": "npm run typecheck --workspace packages/shared",
    "build:bookmarklet": "npm run build --workspace apps/quest-bridge",
    "build:bookmarklet:prod": "npm run build --workspace apps/quest-bridge",
    "build:controller": "npm run build --workspace apps/controller",
    "build:server": "npm run build --workspace apps/server",
    "start": "npm run build && npm run start --workspace apps/server",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "npm run test --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
